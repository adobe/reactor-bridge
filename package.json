{
  "name": "@adobe/reactor-bridge",
  "version": "12.1.0-beta.2",
  "description": "Communication API between the Tags UI (Lens) and extension views.",
  "author": {
    "name": "Adobe",
    "url": "http://adobe.com",
    "email": "reactor@adobe.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:adobe/reactor-bridge.git"
  },
  "scripts": {
    "build:child": "./scripts/buildChild.js",
    "build:parent": "babel src --out-dir lib --ignore __tests__",
    "build": "npm run clean && npm-run-all --parallel build:child build:parent",
    "clean": "npm-run-all --parallel clean-dist clean-test-dist",
    "clean-dist": "rm -rf dist",
    "clean-test-dist": "rm -rf test-dist",
    "test:unit": "playwright test",
    "test": "npm-run-all build test:unit",
    "sandbox": "./scripts/runSandbox.js",
    "prepublish": "npm run build"
  },
  "files": [
    "dist",
    "lib"
  ],
  "main": "./lib/parent.js",
  "dependencies": {
    "penpal": "^4.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.10",
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@playwright/test": "^1.45.0",
    "@rollup/plugin-babel": "^5.2.2",
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.1",
    "babel-preset-minify": "^0.5.1",
    "connect": "^3.6.6",
    "fs-extra": "^7.0.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^2.36.1",
    "serve-static": "^1.11.1",
    "uglify-js": "^3.3.18",
    "yargs": "^16.2.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "engines": {
    "node": ">=v24.0.0"
  }
}
